# Copy this file to .env. For development, start a local database with
# `npm run db:local -w server` and use these two lines:
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# Or a Neon connection string (Dashboard → Connect), as used in production:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"
PORT=3001
# Production only: the client's address, e.g. https://bageti.vercel.app (not needed locally)
# CLIENT_ORIGIN=
# Signs login cookies. Any long random string, e.g. from `openssl rand -hex 32`
JWT_SECRET=
# Admin account, created (or its password updated) when the server starts
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=
